{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ],
      "env": [
        "NEXT_POSTGRES_URL",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "AUTH_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "ANTHROPIC_API_KEY",
        "DEEPSEEK_API_KEY",
        "ENCRYPTION_KEY",
        "MAIL_FROM",
        "MAIL_PASSWORD",
        "NOTIFY_EMAIL",
        "RAZORPAY_KEY_ID",
        "RAZORPAY_KEY_SECRET",
        "RAZORPAY_WEBHOOK_SECRET",
        "GITHUB_MOBILE_CLIENT_ID",
        "GITHUB_MOBILE_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "NEXT_PUBLIC_APP_URL",
        "SARVAM_API_KEY",
        "GOOGLE_AI_API_KEY",
        "META_WA_PHONE_NUMBER_ID",
        "META_WA_ACCESS_TOKEN",
        "META_WA_APP_SECRET",
        "META_WA_VERIFY_TOKEN",
        "MEET_BOT_URL",
        "MEET_BOT_SECRET",
        "NEXT_AWS_ACCESS_KEY_ID",
        "NEXT_AWS_SECRET_ACCESS_KEY",
        "NEXT_AWS_BUCKET_NAME",
        "NEXT_AWS_S3_REGION",
        "GITHUB_APP_ID",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_APP_SLUG",
        "GITHUB_APP_WEBHOOK_SECRET",
        "CRON_SECRET",
        "NEXT_DIRECT_URL",
        "NEXT_PUBLIC_GLITCHGRAB_TOKEN",
        "RAZORPAY_PLAN_PLATFORM",
        "KIMI_API_KEY",
        "MEET_BOT_CALLBACK_URL",
        "META_WA_PUBLIC_NUMBER",
        "NEXT_OTP_AUTH_KEY",
        "SMS_OTP_TEMPLATE",
        "SMS_DLT_TE_ID",
        "SMS_SENDER_ID"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_POSTGRES_URL",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "AUTH_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "ANTHROPIC_API_KEY",
        "DEEPSEEK_API_KEY",
        "ENCRYPTION_KEY",
        "MAIL_FROM",
        "MAIL_PASSWORD",
        "NOTIFY_EMAIL",
        "RAZORPAY_KEY_ID",
        "RAZORPAY_KEY_SECRET",
        "RAZORPAY_WEBHOOK_SECRET",
        "GITHUB_MOBILE_CLIENT_ID",
        "GITHUB_MOBILE_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "NEXT_PUBLIC_APP_URL",
        "SARVAM_API_KEY",
        "GOOGLE_AI_API_KEY",
        "META_WA_PHONE_NUMBER_ID",
        "META_WA_ACCESS_TOKEN",
        "META_WA_APP_SECRET",
        "META_WA_VERIFY_TOKEN",
        "MEET_BOT_URL",
        "MEET_BOT_SECRET",
        "NEXT_AWS_ACCESS_KEY_ID",
        "NEXT_AWS_SECRET_ACCESS_KEY",
        "NEXT_AWS_BUCKET_NAME",
        "NEXT_AWS_S3_REGION",
        "GITHUB_APP_ID",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_APP_SLUG",
        "GITHUB_APP_WEBHOOK_SECRET",
        "CRON_SECRET",
        "NEXT_DIRECT_URL",
        "NEXT_PUBLIC_GLITCHGRAB_TOKEN",
        "RAZORPAY_PLAN_PLATFORM",
        "KIMI_API_KEY",
        "MEET_BOT_CALLBACK_URL",
        "META_WA_PUBLIC_NUMBER",
        "NEXT_OTP_AUTH_KEY",
        "SMS_OTP_TEMPLATE",
        "SMS_DLT_TE_ID",
        "SMS_SENDER_ID"
      ]
    },
    "lint": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "validate": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  }
}
