generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("NEXT_POSTGRES_URL")
  directUrl = env("NEXT_DIRECT_URL")
}

// ─── Pre-launch ──────────────────────────────────────────

model Waitlist {
  id          String   @id @default(cuid())
  email       String   @unique
  source      String?  @default("landing")
  priceFeel   String?
  topFeature  String?
  currentTool String?
  suggestion  String?
  createdAt   DateTime @default(now())
}

// ─── Auth ────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  githubLogin      String?
  whatsappPhone    String?
  /// Digest nudges (morning + evening) stay silent until this moment. Set when
  /// the user replies LEAVE on WhatsApp; null means "message me normally".
  /// See lib/digest.ts and /api/v1/cron/daily-digest.
  digestMutedUntil DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  repos               Repo[]
  aiConfig            AiConfig?
  subscription        Subscription?
  webhooks            Webhook[]
  gscProperties       GscProperty[]
  gscConnectSessions  GscConnectSession[]
  ownedOrgs           Organization[]
  orgMemberships      OrgMember[]
  glitchRecordTokens  GlitchRecordToken[]
  aiEnhanceLogs       AiEnhanceLog[]
  whatsappOtps        WhatsappOtp[]
  extensionSessions   ExtensionSession[]
  repoMemberships     RepoMember[]
  calendarConnections CalendarConnection[]
  calendarInvites     CalendarInvite[]
  loginTokens         LoginToken[]
  storeExtensions     StoreExtension[]
  storeConnections    StoreConnection[]
}

/// Single-use, 48-hour auto-login token behind the "Open dashboard" button on a
/// WhatsApp digest. Minted server-side only, for a user whose WhatsApp number we
/// already verified, and delivered ONLY to that number — there is no
/// mint-for-any-user endpoint. Consumed atomically in NextAuth `authorize()`
/// (updateMany on `usedAt: null` + `count === 1`), so a double-tap or a
/// forwarded screenshot can never authorize twice.
model LoginToken {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  targetPath String    @default("/dashboard")
  purpose    String    @default("DIGEST_DEEPLINK")
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId, createdAt])
}

model WhatsappOtp {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  otpHash   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core ────────────────────────────────────────────────

model Installation {
  id             String   @id @default(cuid())
  installationId Int      @unique
  accountLogin   String
  accountType    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  repos Repo[]
}

model Repo {
  id              String    @id @default(cuid())
  userId          String
  orgId           String?
  installationId  String?
  githubId        Int
  fullName        String
  owner           String
  name            String
  isPrivate       Boolean   @default(false)
  /// Last push to the default branch, per GitHub. Refreshed hourly by
  /// `cron/repo-activity`, never read live: the in-Meet project picker orders
  /// by it, and that list is built while someone is seconds from a client call.
  pushedAt        DateTime?
  /// Opt-in AI report assistant (#330). Off by default and owned by the repo,
  /// not the reporter: the dialog is opened by SDK end users, QA testers and
  /// the owner alike, and only the owner is in a position to accept the cost.
  /// The server reads this off the repo the token/session resolves to — a
  /// client is never asked whether AI is on.
  aiAssistEnabled Boolean   @default(false)
  createdAt       DateTime  @default(now())

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  org               Organization?          @relation(fields: [orgId], references: [id], onDelete: SetNull)
  installation      Installation?          @relation(fields: [installationId], references: [id], onDelete: SetNull)
  tokens            ApiToken[]
  reports           Report[]
  feedback          Feedback[]
  issues            Issue[]
  gscProperties     GscProperty[]
  testerRepos       TesterRepo[]
  qaChecks          QaCheck[]
  bookingPage       BookingPage?
  bookings          Booking[]
  clientLinks       ClientProject[]
  calendarInvites   CalendarInvite[]
  extensionSessions ExtensionSession[]
  members           RepoMember[]
  contextItems      ProjectContextItem[]
  meetings          Meeting[]
  aiAssistChats     AiAssistConversation[]
  storeExtensions   StoreExtension[]

  @@unique([userId, githubId])
  @@index([githubId])
  @@index([orgId])
  @@index([installationId])
}

model ApiToken {
  id        String    @id @default(cuid())
  repoId    String
  tokenHash String    @unique
  name      String    @default("Default")
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  /// Public no-auth slug for the tester report link — null = link disabled
  shareSlug String?   @unique

  repo              Repo               @relation(fields: [repoId], references: [id], onDelete: Cascade)
  reports           Report[]
  feedback          Feedback[]
  aiEnhanceLogs     AiEnhanceLog[]
  extensionSessions ExtensionSession[]
}

// ─── End-user feedback (#309) ────────────────────────────
// NOT feedback about Glitchgrab — this is feedback the SDK consumer's own
// end-users leave about the consumer's app. Glitchgrab hosts the storage so
// the consumer writes zero DB code. Never creates a GitHub issue.
model Feedback {
  id                 String   @id @default(cuid())
  repoId             String
  /// Always derived from the hashed gg_ token — never client-supplied.
  tokenId            String?
  /// 1–5 stars.
  rating             Int
  message            String?
  pageUrl            String?
  userAgent          String?
  metadata           Json?
  /// Owner moderation flag. Off by default — the consumer opts each entry in
  /// before it can be served as a public testimonial via ?approved=true.
  approved           Boolean  @default(false)
  /// Primary key of the end-user in the host app's database
  reporterPrimaryKey String
  reporterName       String
  reporterEmail      String?
  reporterPhone      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  repo  Repo      @relation(fields: [repoId], references: [id], onDelete: Cascade)
  token ApiToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([repoId, createdAt])
  @@index([repoId, approved])
  @@index([repoId, reporterPrimaryKey])
}

// ─── Extension tester sessions (work-time tracking, #297) ────
// A login session in the packages/extension popup — tester pastes a gg_
// token + types name/email once. Duration (startedAt → endedAt/lastPingAt)
// is the "tester work time" shown in the audit log.
model ExtensionSession {
  id          String    @id @default(cuid())
  /// Null when the session came from a QA-tester magic link, or a dashboard
  /// user's own auto-login (no gg_ token involved) instead of the manual
  /// popup token-paste login (#297).
  tokenId     String?
  /// Null until GlitchRecord actually starts recording against a repo — the
  /// dashboard/QA auto-login doesn't know a repo up front (a dashboard owner
  /// may have dozens; a QA tester may be assigned several). Backfilled with
  /// the REAL repo being recorded once known — see broadcastRecordingStart.
  repoId      String?
  /// Set for a QA magic-link auto-login — scopes the extension's own report
  /// UI to ONLY this tester's assigned repos (TesterRepo), never the full
  /// account. Mutually exclusive with userId.
  testerId    String?
  /// Set for a dashboard-owner auto-login — scopes the report UI to every
  /// repo that user owns. Mutually exclusive with testerId.
  userId      String?
  testerName  String
  testerEmail String?
  startedAt   DateTime  @default(now())
  lastPingAt  DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  token  ApiToken? @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  repo   Repo?     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  tester Tester?   @relation(fields: [testerId], references: [id], onDelete: Cascade)
  user   User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([repoId])
  @@index([tokenId])
  @@index([testerId])
  @@index([userId])
}

// ─── Reports & Issues ────────────────────────────────────

enum ReportSource {
  SDK_AUTO
  SDK_USER_REPORT
  DASHBOARD_UPLOAD
  HANDWRITTEN_NOTE
  MCP
  PUBLIC_LINK
  /// Filed via the GlitchRecord/Chrome-extension capture pipeline by a
  /// tester logged into the extension with a gg_ token (see #297)
  EXTENSION_TESTER
  /// Extracted from a recorded client call by the meeting issue assistant.
  /// The "reporter" is whoever recorded the call, not the person who spoke.
  MEETING
}

enum ReportStatus {
  PENDING
  PROCESSING
  CREATED
  DUPLICATE
  FAILED
}

model Report {
  id                     String       @id @default(cuid())
  repoId                 String
  tokenId                String?
  source                 ReportSource
  status                 ReportStatus @default(PENDING)
  rawInput               String?
  screenshot             String?
  errorStack             String?
  userAgent              String?
  pageUrl                String?
  /// Hash of errorMessage + pageUrl + top stack frame for dedup
  signature              String?
  metadata               Json?
  aiResponse             Json?
  failReason             String?
  /// Primary key of the reporter in the host app's database
  reporterPrimaryKey     String
  reporterName           String
  reporterEmail          String?
  reporterPhone          String?
  /// When this report was run through project-context distillation (#311).
  /// Stamped even when the run produced nothing, so a report is never re-sent
  /// to the model — "no items" is an answer, not a retry.
  contextDistilledAt     DateTime?
  /// The assistant chat this report came out of, when it came out of one.
  /// Null for every report typed by hand — which is how "did the assistant
  /// help?" is answerable at all: the linked rows carry the turn count that
  /// produced a filed issue, the unlinked ones are the baseline.
  aiAssistConversationId String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  repo                 Repo                  @relation(fields: [repoId], references: [id], onDelete: Cascade)
  token                ApiToken?             @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  issue                Issue?
  aiAssistConversation AiAssistConversation? @relation(fields: [aiAssistConversationId], references: [id], onDelete: SetNull)

  @@index([repoId, signature, createdAt])
  @@index([repoId, contextDistilledAt])
  @@index([aiAssistConversationId])
}

model Issue {
  id           String   @id @default(cuid())
  reportId     String   @unique
  repoId       String
  githubNumber Int
  githubUrl    String
  title        String
  body         String
  labels       String[]
  severity     String?
  isDuplicate  Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Set when GitHub marks the issue closed; cleared if reopened before the
  // delayed WhatsApp notify fires. See /api/v1/cron/resolved-notify.
  resolvedAt         DateTime?
  resolvedNotifiedAt DateTime?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  repo   Repo   @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, resolvedNotifiedAt])
}

// ─── Billing ─────────────────────────────────────────────

model Subscription {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  razorpaySubscriptionId String   @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── AI Config ───────────────────────────────────────────

enum AiProvider {
  PLATFORM
  OPENAI
  ANTHROPIC
}

model AiConfig {
  id              String     @id @default(cuid())
  userId          String     @unique
  provider        AiProvider @default(PLATFORM)
  encryptedApiKey String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Google Search Console ───────────────────────────

model GscProperty {
  id                    String    @id @default(cuid())
  userId                String
  siteUrl               String
  repoId                String?
  encryptedAccessToken  String
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  indexedCount          Int       @default(0)
  notIndexedCount       Int       @default(0)
  lastSyncAt            DateTime?
  cachedNotIndexedPages Json?
  seoHealthIssueUrl     String?
  seoHealthSnoozedUntil DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo              Repo?                 @relation(fields: [repoId], references: [id], onDelete: SetNull)
  indexingSnapshots GscIndexingSnapshot[]

  @@unique([userId, siteUrl])
}

// ─── GSC Indexing Snapshot — historical record per sync/reindex ────────

model GscIndexingSnapshot {
  id              String   @id @default(cuid())
  propertyId      String
  // "sync" = full sitemap inspection; "reindex" = re-indexing submission
  kind            String
  // counts at time of snapshot
  indexedCount    Int      @default(0)
  notIndexedCount Int      @default(0)
  totalChecked    Int      @default(0)
  // For "reindex" entries: how many URLs we actually submitted to Google
  submittedCount  Int?
  createdAt       DateTime @default(now())

  property GscProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
}

// ─── GSC Connect Session (temporary, expires after 10 min) ────────────────

model GscConnectSession {
  id               String   @id @default(cuid())
  userId           String
  encryptedAccess  String
  encryptedRefresh String?
  tokenExpiresAt   DateTime
  sites            Json // Array of {siteUrl: string, permissionLevel: string}
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Organizations ────────────────────────────────────

enum OrgRole {
  OWNER
  MEMBER
}

model Organization {
  id             String   @id @default(cuid())
  githubOrgLogin String   @unique
  githubOrgId    Int      @unique
  name           String
  ownerId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner   User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members OrgMember[]
  repos   Repo[]
  testers Tester[]
}

model OrgMember {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

// ─── Webhooks ──────────────────────────────────────────

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Auth token for GlitchRecord desktop app
model GlitchRecordToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// AI enhance before/after log — for auditing whether AI is preserving user intent
model AiEnhanceLog {
  id           String   @id @default(cuid())
  originalText String
  enhancedText String
  changed      Boolean // false = AI returned same text
  pageUrl      String?
  apiTokenId   String? // set when called from SDK
  userId       String? // set when called from dashboard session
  createdAt    DateTime @default(now())

  apiToken ApiToken? @relation(fields: [apiTokenId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

/// One AI-assisted report composition (#330).
///
/// A row is created on the FIRST message of a conversation and is the unit the
/// monthly cap counts — a long back-and-forth costs the same quota as a short
/// one, so the reporter is never punished for the model needing another
/// question. `turns` is the separate guard that stops one conversation looping
/// forever.
///
/// Deliberately stores no message bodies: the transcript is a draft bug report
/// typed by an end user of somebody else's app, and it is already persisted, on
/// purpose and with consent, the moment they press Send. Keeping a second copy
/// of every abandoned draft buys nothing and is a liability.
model AiAssistConversation {
  id            String   @id @default(cuid())
  repoId        String
  /// Model round-trips spent. Hard-capped server-side (see lib/ai-assist/quota).
  turns         Int      @default(0)
  /// Who was composing, for abuse tracing. All three are nullable and only one
  /// is ever set: SDK end users have a token, QA testers a testerId, dashboard
  /// and GlitchRecord owners a userId. Plain scalars, no FKs — a revoked token
  /// or a deleted tester must not erase the audit trail.
  tokenId       String?
  userId        String?
  testerId      String?
  /// How the conversation ended. "SOLVED" means the project's own GLITCH.md
  /// brief (or an open issue) answered it and the reporter said so — nothing
  /// was filed. Counting those is how a team learns which guides are earning
  /// their keep, and which question keeps coming back and should become a fix.
  /// Null while a conversation is still open, or when it simply went quiet.
  outcome       String?
  /// Who was typing, as the host app knows them. `tokenId`/`userId`/`testerId`
  /// above identify the CREDENTIAL; these identify the PERSON — an SDK end user
  /// is a stranger to us and one token covers all of them, so without this a
  /// thousand conversations look like one caller. Same three fields the report
  /// itself carries (`reporterPrimaryKey`/`reporterName`/`reporterEmail`), from
  /// the same source, so a chat and the report it produced agree on who filed.
  reporterKey   String?
  reporterName  String?
  reporterEmail String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  repo     Repo              @relation(fields: [repoId], references: [id], onDelete: Cascade)
  messages AiAssistMessage[]
  reports  Report[]

  @@index([repoId, createdAt])
}

/// Every message of an assistant chat, both sides, in order.
///
/// This is a training corpus, not a feature: the question it exists to answer
/// is "how many turns does a filed issue actually cost, and what did the model
/// have to ask to get there". Joined to `Report.aiAssistConversationId` it says
/// which transcripts ended in an issue and which went nowhere.
///
/// Written best-effort AFTER the reply is computed — a failed insert here must
/// never fail a turn the reporter is waiting on.
model AiAssistMessage {
  id             String   @id @default(cuid())
  conversationId String
  /// "user" | "assistant"
  role           String
  content        String
  /// 1-based model round-trip this message belongs to. The user message and
  /// the reply it produced share a turn, which is what makes "prompts per
  /// issue" countable without re-deriving it from timestamps.
  turn           Int
  /// Whether the model could see the screenshot on this turn. The image itself
  /// is never stored — it is up to MAX_SCREENSHOT_CHARS of base64 per turn and
  /// the only training signal in it is that it was there.
  hadScreenshot  Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation AiAssistConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Temporary click-capture sessions for Recordly script generation
model CaptureSession {
  id        String   @id @default(cuid())
  events    Json
  meta      Json? // RecordingMeta from Recordly — clips, cuts, duration
  script    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Persistent narration training/feedback telemetry. Unlike CaptureSession (which
// expires), this survives so we can analyze how much refinement scripts need and
// improve the model. One row per capture session; the generate route writes the
// initial row, the refine route appends each user refinement turn. Writes are
// best-effort — telemetry must NEVER break script generation.
model NarrationTelemetry {
  id        String @id @default(cuid())
  sessionId String @unique // the CaptureSession id this generation came from

  // ── Input context ───────────────────────────────────────────────
  events      Json // raw captured events, as-is (incl. typed previews)
  meta        Json? // RecordingMeta (cuts/zooms/duration)
  appName     String? // derived product name (deriveAppName)
  lang        String?
  gender      String?
  durationSec Int?
  eventCount  Int     @default(0)
  hasNotes    Boolean @default(false) // any shift-mark "note" events present
  noteCount   Int     @default(0)
  noteAnswers Json? // what the user said to explain at each marked spot

  // ── Initial generation ──────────────────────────────────────────
  model             String // deepseek model used for generation
  genLatencyMs      Int     @default(0)
  initialScript     String  @default("")
  initialChars      Int     @default(0)
  wasEmpty          Boolean @default(false) // generation returned nothing
  wasRoman          Boolean @default(false) // lang=hi but came back Roman/Latin
  devanagariRetried Boolean @default(false) // the Devanagari-fix retry fired
  devanagariRatio   Float   @default(0)

  // ── Refinements (appended by the refine route) ──────────────────
  // refinements: [{ ts, userMessage, resultingScript, chars }] — full history of
  // what the user asked to change and the version it produced.
  refinements Json   @default("[]")
  refineCount Int    @default(0) // how many versions the user needed (quality proxy)
  finalScript String @default("")
  finalChars  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appName])
  @@index([createdAt])
}

// ─── QA / Tester workflow ────────────────────────────────
// A tester (e.g. an external QA person) invited to verify that developer
// fixes actually work. May NOT be part of the GitHub org — accesses a
// magic-link QA page instead of logging in. Notified over WhatsApp.

model Tester {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  email       String?
  phone       String? // WhatsApp number (digits, optional country code)
  /// Unguessable capability token — the /qa/<token> page is gated only by this
  magicToken  String   @unique
  invitedById String
  createdAt   DateTime @default(now())

  org               Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repos             TesterRepo[]
  checks            QaCheck[]
  otps              TesterOtp[]
  extensionSessions ExtensionSession[]

  @@index([orgId])
}

model TesterOtp {
  id        String   @id @default(cuid())
  testerId  String
  phone     String
  otpHash   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  tester Tester @relation(fields: [testerId], references: [id], onDelete: Cascade)

  @@index([testerId])
}

model TesterRepo {
  id        String   @id @default(cuid())
  testerId  String
  repoId    String
  createdAt DateTime @default(now())

  tester Tester @relation(fields: [testerId], references: [id], onDelete: Cascade)
  repo   Repo   @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([testerId, repoId])
  @@index([repoId])
}

enum QaStatus {
  PENDING
  PASS
  FAIL
  SKIPPED
}

model QaCheck {
  id                 String    @id @default(cuid())
  testerId           String
  repoId             String
  githubNumber       Int
  githubUrl          String
  title              String
  prNumber           Int?
  prUrl              String?
  /// GitHub login of the developer who merged the PR that closed this issue
  developerLogin     String?
  status             QaStatus  @default(PENDING)
  createdAt          DateTime  @default(now())
  verifiedAt         DateTime?
  /// Tester's explanation of what's not working, required on FAIL
  failReason         String?
  /// S3/CDN URL of the screenshot the tester attached on FAIL
  failScreenshotUrl  String?
  /// When the WhatsApp tester-notify was sent. Null = still waiting out the
  /// post-merge deploy delay (see /api/v1/cron/qa-notify).
  notifiedAt         DateTime?
  /// When this check was run through project-context distillation (#311). See
  /// Report.contextDistilledAt — same contract.
  contextDistilledAt DateTime?

  tester Tester @relation(fields: [testerId], references: [id], onDelete: Cascade)
  repo   Repo   @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([testerId, repoId, githubNumber, prNumber])
  @@index([testerId, status])
  @@index([repoId, githubNumber])
  @@index([notifiedAt])
  @@index([repoId, contextDistilledAt])
}

// ─── Google Calendar → auto-record (#311) ────────────────
// Replaces the cal.com path entirely: the meetings already live in Google
// Calendar with a Meet link attached, so that IS the schedule. We read it and
// send the bot; nothing new for anyone to book through.

model CalendarConnection {
  id                    String    @id @default(cuid())
  userId                String
  /// The Google account whose calendar this is.
  googleEmail           String
  encryptedAccessToken  String
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  /// Project used for events with no explicit assignment. Null = never
  /// auto-record; every event must be assigned by hand first.
  defaultRepoId         String?
  /// Master switch — off means we read the calendar but send no bot.
  autoRecord            Boolean   @default(false)
  lastSyncAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings     ScheduledRecording[]
  bookingPages BookingPage[]

  @@unique([userId, googleEmail])
}

enum ScheduledRecordingStatus {
  /// Waiting for its start time.
  PENDING
  /// Bot has been sent.
  DISPATCHED
  /// Deliberately not recorded.
  SKIPPED
  FAILED
}

/// One upcoming calendar event we intend to record. Keyed on the Google event
/// id so the sync is idempotent — the poller runs repeatedly and must never
/// send two bots to the same call.
model ScheduledRecording {
  id              String                   @id @default(cuid())
  connectionId    String
  calendarEventId String
  repoId          String?
  title           String?
  meetUrl         String
  startsAt        DateTime
  endsAt          DateTime?
  attendees       Json?
  status          ScheduledRecordingStatus @default(PENDING)
  /// The Meeting this became, once the bot was actually sent.
  meetingId       String?
  error           String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, calendarEventId])
  @@index([status, startsAt])
}

/// What the Chrome Web Store says about a submission right now.
///
/// Deliberately coarse: the store's own vocabulary changes, and the only
/// question a developer actually has is "is it live, is Google still looking at
/// it, or is it sitting somewhere waiting for me?".
enum ExtensionReviewState {
  /// Uploaded or edited, never submitted. The trap this whole feature exists
  /// for — a draft looks identical to "shipped" from the outside.
  DRAFT
  /// Submitted, Google is looking at it.
  IN_REVIEW
  /// Live for users.
  PUBLISHED
  /// Rejected or taken down — needs a human.
  NEEDS_ATTENTION
  /// The store answered something we don't recognise, or we could not reach it.
  UNKNOWN
}

/// One Chrome extension we watch on the Web Store (#332).
///
/// A submission's outcome lands hours or days after the release workflow has
/// exited, so nothing in CI can ever report it. This row is what a cron polls,
/// and what turns "it's been in review since Tuesday" into a WhatsApp instead
/// of a dashboard nobody opens.
model StoreExtension {
  id     String  @id @default(cuid())
  userId String
  /// Optional: which project this extension belongs to, so the release shows
  /// up next to the repo it was built from.
  repoId String?
  name   String

  /// The 32-character Chrome Web Store item id.
  itemId String

  /// Which connected Google account can read this item's status.
  connectionId String

  publishedVersion String?
  submittedVersion String?
  state            ExtensionReviewState @default(UNKNOWN)
  /// Extra detail from the store — a rejection reason, or why we can't read it.
  stateDetail      String?

  /// The state someone was last told about. Without it a review in progress
  /// sends the same message every poll.
  notifiedState ExtensionReviewState?
  /// When `state` last changed. A draft that has sat untouched for a day is
  /// worth a nudge; one from ten minutes ago is just someone mid-release.
  stateSince    DateTime?

  lastCheckedAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo       Repo?           @relation(fields: [repoId], references: [id], onDelete: SetNull)
  connection StoreConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([state])
  @@index([connectionId])
}

/// A Google account connected for Chrome Web Store access (#332).
///
/// One connection covers every extension on that publisher account — the thing
/// a service-account key file could not do without being pasted again per
/// extension. The developer clicks Connect once; adding the next extension is
/// two ids and nothing else.
///
/// Read-only scope on purpose (`chromewebstore.readonly`): the watcher only
/// ever asks what the store thinks. A connection made for status reporting
/// must not double as a way to publish to everyone's browser.
model StoreConnection {
  id          String @id @default(cuid())
  userId      String
  /// Which Google account this is, so the UI can say whose access it is.
  googleEmail String

  /// The publisher every item on this account belongs to. Lives here rather
  /// than on the extension because it is the same value for all of them —
  /// asking again per extension is asking the same question twice.
  publisherId String?

  /// OAuth refresh token, AES-256-GCM. Access tokens last an hour; this is what
  /// survives, and it is exactly as sensitive as the account's store access.
  refreshToken String

  /// Set when Google stops accepting the token — revoked, or the consent screen
  /// was left in Testing, where refresh tokens die after 7 days.
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  extensions StoreExtension[]

  @@unique([userId, googleEmail])
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// ─── Project context (#311 Phase A) ──────────────────────

/// Explicit user ↔ repo grant. Project context (client calls, distilled
/// decisions) is more sensitive than bug reports, so org membership alone does
/// NOT grant read access — a row here does. Same shape as TesterRepo.
/// The repo owner (Repo.userId) is implicit and never needs a row.
model RepoMember {
  id        String   @id @default(cuid())
  repoId    String
  userId    String
  /// Who granted access. Kept for audit; null if the row predates the grantor.
  grantedBy String?
  createdAt DateTime @default(now())

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repoId, userId])
  @@index([userId])
}

enum ContextKind {
  DECISION
  REQUEST
  COMPLAINT
  COMMITMENT
  FACT
}

enum ContextSourceType {
  MEETING
  REPORT
  CAPTURE
  QA
  MANUAL
}

/// One distilled fact about a project. The unit of project memory: many of
/// these on a Repo answer "what did the client ask for, what shipped, what's
/// still broken, what did we promise in March".
model ProjectContextItem {
  id          String            @id @default(cuid())
  repoId      String
  kind        ContextKind
  text        String
  sourceType  ContextSourceType
  /// Id of the originating row (Report.id, QaCheck.id, Meeting.id…). Null for
  /// MANUAL paste — there is no row to point back at.
  sourceId    String?
  /// When the thing actually happened (the report's createdAt, the call date),
  /// NOT when it was distilled. The timeline sorts on this.
  occurredAt  DateTime
  /// Model's 0–1 self-rated confidence. Low-confidence items are dropped at
  /// distillation time rather than stored and filtered later.
  confidence  Float             @default(1)
  /// Who ran the distillation. Null for system/cron-created rows.
  createdById String?
  createdAt   DateTime          @default(now())

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, occurredAt])
  @@index([repoId, kind])
  @@index([sourceType, sourceId])
}

enum TranscriptStatus {
  /// Recording exists (or is still uploading); no transcription requested yet.
  IDLE
  /// Submitted to Sarvam; the poll cron is watching it.
  RUNNING
  DONE
  FAILED
}

/// A recorded client call (#311 Phase B/C) — the tldv replacement.
///
/// repoId is required on purpose: a meeting with no project is not project
/// memory, and the org is derived from the repo.
///
/// **Audio only, two tracks.** `tabRecordingKey` is the Meet tab's audio (the
/// client — Meet never plays your own voice back, so that track is them) and
/// `micRecordingKey` is the operator's microphone. Kept separate rather than
/// mixed: which file a line came from IS the speaker, which beats anything
/// diarization can infer, and it stays right when both people talk at once.
/// Per-project demo booking, opened from the SDK dialog on the customer's own
/// site (#311 follow-on — replaces cal.com).
///
/// One page per repo, because a booking is only meaningful against a project:
/// it decides whose calendar is read, which Meet is created, and where the
/// recording is filed afterwards.
/// Someone who books demos with us — keyed by WhatsApp number.
///
/// A person is not a booking: the same number turns up for PracticeStack this
/// month and a library project the next, and the second conversation should
/// not start by asking their name again. Phone rather than email is the key
/// because WhatsApp is the channel that identifies them.
model Client {
  id    String  @id @default(cuid())
  phone String  @unique
  name  String?
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ClientProject[]
  bookings Booking[]
}

/// Which of our projects a client has engaged with.
///
/// The link exists so a returning number can be offered "PracticeStack again,
/// or something else?" instead of a cold menu of every project we run.
model ClientProject {
  id       String @id @default(cuid())
  clientId String
  repoId   String

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  repo   Repo   @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([clientId, repoId])
}

enum WhatsappThreadStep {
  /// Number is known to several projects, or arrived cold — ask which.
  CHOOSE_PROJECT
  CHOOSE_DATE
  CHOOSE_TIME
  ASK_NAME
  ASK_EMAIL
  DONE
}

/// Where a WhatsApp booking conversation has got to.
///
/// WhatsApp gives no session of its own — every inbound message is just a
/// number and some text — so the thread state has to live here or the bot
/// forgets what it asked between one message and the next.
model WhatsappThread {
  id    String @id @default(cuid())
  phone String @unique

  step         WhatsappThreadStep @default(CHOOSE_PROJECT)
  repoId       String?
  /// Slot the visitor picked, held once they choose a time.
  pendingStart DateTime?
  /// Page offset while paging through the next fortnight of dates.
  datePage     Int                @default(0)
  name         String?
  email        String?

  /// Meta only allows free-form replies within 24h of the customer's last
  /// message. Past this the bot must fall back to a template or stay quiet.
  lastInboundAt DateTime @default(now())
  bookingId     String?

  /// Set while this thread is MOVING an existing booking rather than making a
  /// new one. The date and time pickers are shared between the two flows, so
  /// without a discriminant a reschedule silently creates a second demo and
  /// leaves the original on the calendar.
  ///
  /// Cleared the moment the move completes: a stale value would make the next
  /// fresh booking from this number overwrite the one it just finished.
  rescheduleId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([step, updatedAt])
}

/// A one-time link that lets someone else attach THEIR Google Calendar to one
/// of your projects.
///
/// The client whose demos we are booking has their own Gmail, on their own
/// machine. The normal connect flow needs a Glitchgrab session, so it only ever
/// works for the account holder — this is the way to say "open this and sign in
/// with your own Google", without giving them a login or sight of the dashboard.
///
/// Deliberately narrow: an invite can only ADD a calendar to the one project it
/// was minted for. It grants no read access to anything, and dies on first use.
model CalendarInvite {
  id String @id @default(cuid())

  /// Whose Glitchgrab account the resulting connection belongs to.
  userId String
  /// The project whose demos this calendar will host.
  repoId String

  /// Shown on the landing page so the client knows what they are agreeing to.
  label String?

  /// Single-use. Set the moment a connection is created from it.
  usedAt       DateTime?
  /// Set once used — which connection this invite produced.
  connectionId String?
  expiresAt    DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model BookingPage {
  id     String @id @default(cuid())
  repoId String @unique

  /// Off means the SDK dialog refuses to open — a project that has not set
  /// working hours must not offer slots it cannot honour.
  enabled       Boolean @default(false)
  /// Length of a demo, in minutes.
  slotMinutes   Int     @default(30)
  /// Dead time kept after each booking so calls don't butt up against each
  /// other. Applied when generating slots, not stored on the event.
  bufferMinutes Int     @default(15)
  /// IANA zone the working hours are expressed in (e.g. "Asia/Kolkata").
  /// Slots are offered in the visitor's own zone, but the owner's hours are
  /// only meaningful in the owner's.
  timezone      String  @default("Asia/Kolkata")
  /// `{ "1": [["10:00","18:00"]], ... }` keyed by ISO weekday (1 = Monday).
  /// Free-form rather than columns: a day can have several ranges, and this is
  /// read as a whole or not at all.
  workingHours  Json?

  /// Short code used in the WhatsApp deep link ("demo practicestack"), so an
  /// inbound message already knows which project it is about. Unique across
  /// projects because it arrives as bare text with nothing else to scope it.
  whatsappCode String? @unique

  /// Which connected Google account this project's demos are booked into.
  ///
  /// One Glitchgrab account can hold a client's calendar alongside its own —
  /// PracticeStack demos belong on the PracticeStack calendar, not on whichever
  /// account happened to be connected first. Null falls back to the oldest
  /// connection, which is right for a single-calendar setup and wrong the
  /// moment a second client is added.
  calendarConnectionId String?

  /// Shown at the top of the booking dialog.
  title       String?
  description String?

  /// How far ahead visitors may book, and the minimum notice before a slot.
  /// Without notice, someone books a call starting in ninety seconds.
  horizonDays   Int @default(21)
  noticeMinutes Int @default(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repo       Repo                @relation(fields: [repoId], references: [id], onDelete: Cascade)
  connection CalendarConnection? @relation(fields: [calendarConnectionId], references: [id], onDelete: SetNull)
  bookings   Booking[]
}

enum BookingStatus {
  /// Slot is held while the visitor enters the WhatsApp code. Expires.
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

/// One demo booked through the SDK dialog.
///
/// The row exists BEFORE the number is verified, because the slot has to be
/// held while the code is in flight — two visitors racing for the last 3pm
/// would otherwise both be told they had it.
model Booking {
  id     String @id @default(cuid())
  pageId String
  repoId String

  name  String
  email String
  /// WhatsApp number, digits only. Required: the number is verified by OTP
  /// before the booking is confirmed, so it is also the anti-abuse gate.
  phone String

  startsAt DateTime
  endsAt   DateTime
  /// What the visitor saw when they picked — kept so a later "3pm your time"
  /// message matches what they booked.
  timezone String?
  note     String?

  status      BookingStatus @default(PENDING)
  /// SHA-256 of the verification code, never the code itself.
  otpHash     String?
  otpSentAt   DateTime?
  otpExpires  DateTime?
  /// Wrong codes tried. Caps a brute force against a six-digit number.
  otpAttempts Int           @default(0)

  /// Set once confirmed: the Google event and its Meet link.
  calendarEventId String?
  meetUrl         String?
  /// The recording this became. Demos are always recorded, whatever the
  /// project's auto-record switch says.
  meetingId       String?

  /// Reminders already sent, so a cron re-run cannot send twice.
  reminderSentAt  DateTime?
  ownerNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set when the booking came from a WhatsApp thread, or when the website
  /// booker's number matched someone we already know.
  clientId String?

  page   BookingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  repo   Repo        @relation(fields: [repoId], references: [id], onDelete: Cascade)
  client Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// NOTE: a slot is claimed exactly once by a PARTIAL unique index created in
  /// the migration — `(repoId, startsAt) WHERE status IN ('PENDING','CONFIRMED')`.
  /// Prisma cannot express a filtered unique index, and a plain one would be
  /// wrong: two cancelled bookings for the same slot are perfectly normal, and
  /// a full unique constraint would reject the second cancellation forever.
  @@index([status, startsAt])
  @@index([repoId, startsAt])
}

model Meeting {
  id               String           @id @default(cuid())
  /// Null while a recording is unfiled — a first call about a prospect or an
  /// idea that has no repo yet. Filing it later is `PATCH /meetings/:id/repo`.
  /// Until then only its creator can see it: repo membership is the only
  /// access control this product has, and a meeting with no repo sits outside
  /// it entirely.
  repoId           String?
  title            String?
  meetUrl          String?
  startsAt         DateTime?
  endsAt           DateTime?
  durationSec      Int?
  /// Attendee list as [{ name, email }]. Free-form until Phase E fixes it.
  participants     Json?
  status           String?
  /// S3 keys — private prefix, presigned GET only, never the screenshot CDN.
  /// These are client conversations.
  tabRecordingKey  String?
  micRecordingKey  String?
  transcript       String?
  /// Per-track raw Sarvam output, kept so the merged transcript can be rebuilt
  /// without re-paying for transcription.
  transcriptRaw    Json?
  /// `[{ track, fileName, offsetMs }]` in the exact order the files were handed
  /// to Sarvam. Sarvam names results positionally ("0.json"), so this ordering
  /// is the ONLY way to attribute a result back to a speaker — without it both
  /// tracks collapse to one label and separate recording was pointless.
  /// `offsetMs` is how much later than the first recorder this track started;
  /// the merge shifts by it instead of assuming a shared time origin.
  transcriptFiles  Json?
  /// `[{ speaker, text, t }]` read from Google Meet's own caption panel.
  /// Used ONLY to attach real names to time ranges — the words come from
  /// Sarvam, which is far more accurate and handles Marathi/Hindi properly.
  /// We capture the tab's mixed audio, so without this remote speakers can
  /// only ever be "Client (0)" / "Client (1)".
  captions         Json?
  transcriptStatus TranscriptStatus @default(IDLE)
  /// Sarvam batch job id. Stored so the poll survives a cold start — without
  /// it a job submitted before a restart can never be collected.
  transcriptJobId  String?
  transcriptError  String?
  /// Who recorded it.
  createdById      String?
  /// "extension" (operator's own Chrome) or "bot" (headless Chromium that
  /// joined the call). Both feed this same row and the same Sarvam pipeline.
  recorder         String?
  /// Live state of a bot recording: JOINING → WAITING_ADMIT → RECORDING →
  /// DONE/FAILED. Null for extension recordings.
  botStatus        String?
  botError         String?
  /// cal.com booking uid. Enrichment only; a meeting exists without it.
  calBookingUid    String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  /// When the issue assistant last read this call. Null = never extracted,
  /// which is what the button on the call page keys off.
  issuesExtractedAt DateTime?

  repo   Repo?               @relation(fields: [repoId], references: [id], onDelete: Cascade)
  frames MeetingFrame[]
  drafts MeetingIssueDraft[]

  @@index([repoId, startsAt])
  @@index([transcriptStatus])
}

/// A still frame the bot grabbed WHILE the call was running.
///
/// Frames are captured up front, on a cadence, because the alternative does not
/// exist: by the time a transcript has been read and a model has an opinion
/// about which moment mattered, the call is over and the pixels are gone. The
/// only way to have a screenshot of the thing someone was demoing is to have
/// already taken it.
///
/// They live in the PRIVATE recordings prefix (`lib/recordings.ts`), never the
/// screenshot CDN — a frame of a client's shared screen is a client
/// conversation, and the CDN is public-read.
model MeetingFrame {
  id        String   @id @default(cuid())
  meetingId String
  /// Milliseconds from the moment recording started, matching transcript time.
  tMs       Int
  /// S3 key, private prefix. Presigned GET only.
  key       String
  /// Bytes on disk. Used to spot a run of identical frames (a static screen)
  /// without re-downloading them.
  bytes     Int?
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, tMs])
}

/// A GitHub issue the assistant thinks the call asked for, BEFORE anyone agreed.
///
/// Nothing here exists on GitHub. The whole point is the gap between "the model
/// heard attendance and assumed a biometric device" and "we meant WhatsApp" —
/// the draft is where that gets corrected, by chatting at it, until a human
/// presses the button that files it.
model MeetingIssueDraft {
  id        String  @id @default(cuid())
  meetingId String
  title     String
  body      String
  labels    String[]
  /// Lines from the transcript the draft is built on, as
  /// `[{ speaker, text, tMs }]`. Shown in the panel so a wrong draft can be
  /// traced to the sentence that caused it instead of argued with blindly.
  quotes    Json?
  /// Ids of the `MeetingFrame`s the model was looking at, as `string[]`.
  frameIds  Json?
  /// DRAFT → CREATED (filed on GitHub) or DISCARDED (rejected by a human).
  status    String  @default("DRAFT")
  /// The correction conversation for THIS draft, as `[{ role, content }]`.
  /// Kept per-draft rather than per-meeting: a correction is almost always
  /// about one misunderstood feature, and replaying every other draft's
  /// arguments at the model is how a good draft gets rewritten into a bad one.
  corrections Json?
  /// Position in the panel. Stable across regenerations so a draft does not
  /// jump while someone is typing at it.
  position    Int      @default(0)
  githubNumber Int?
  githubUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, position])
}

// ─── WhatsApp platform (Glitchgrab as Meta Tech Provider) ──────────
// See agent_docs/whatsapp-platform.md. Distinct from WhatsappOtp /
// WhatsappThread above, which are Glitchgrab's own booking flow.

enum WaWalletOwnerType {
  PLATFORM
  TENANT
}

enum WaWalletTxnKind {
  TOPUP
  DEBIT
  REFUND
  HOLD
  RELEASE
  ADJUSTMENT
}

/// Meta prices per message per category, and the categories differ by
/// multiples. Never collapse these into one rate.
enum WaTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
  SERVICE
}

enum WaTenantStatus {
  PENDING
  CONNECTED
  SUSPENDED
  DISCONNECTED
}

enum WaTemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum WaMessageDirection {
  INBOUND
  OUTBOUND
}

enum WaMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WaNumberStatus {
  PENDING
  VERIFIED
  REGISTERED
  DISCONNECTED
}

/// A SaaS product that resells our WhatsApp infra (Abhyasika, SevaStack).
/// Rows are provisioned by hand — there is no self-serve subscriber signup.
model WaPlatform {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  apiKeyHash  String   @unique
  /// Where we POST template approvals, low balance, delivery status.
  callbackUrl String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants    WaTenant[]
  priceRules WaPriceRule[]
}

/// One business owner inside a platform — a library admin, a clinic.
/// Owns the WABA and the phone number; our credit line pays its Meta bill.
model WaTenant {
  id String @id @default(cuid())

  platformId String
  /// The platform's OWN user id. We map it to this row server-side; the
  /// platform never sends us a tenantId we would have to trust.
  externalOwnerId String

  name   String
  wabaId String?
  status WaTenantStatus @default(PENDING)

  /// System user token for this tenant's WABA, AES-256-GCM via lib/encrypt.ts.
  /// Never stored or logged in plaintext.
  accessTokenEnc String?
  tokenExpiresAt DateTime?

  /// Whether our credit line is attached to this WABA. False means the tenant's
  /// own card pays Meta and our per-message charge is a software fee, not a
  /// resale margin. Onboarding succeeds either way.
  creditLineShared Boolean @default(false)
  creditLineNote   String?

  connectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  platform  WaPlatform   @relation(fields: [platformId], references: [id], onDelete: Cascade)
  numbers   WaNumber[]
  templates WaTemplate[]
  messages  WaMessage[]

  @@unique([platformId, externalOwnerId])
  @@index([wabaId])
}

/// A phone number registered under a tenant's WABA. Usually one, occasionally
/// several. `phoneNumberId` is globally unique and is how inbound webhooks are
/// routed back to a tenant.
model WaNumber {
  id       String @id @default(cuid())
  tenantId String

  phoneNumberId String @unique
  displayNumber String
  verifiedName  String

  status             WaNumberStatus @default(PENDING)
  qualityRating      String?
  messagingLimitTier String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant WaTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// A message template. Mirrors one on Meta, which owns approval — we hold the
/// draft, the submission, and whatever Meta last told us about it.
model WaTemplate {
  id       String @id @default(cuid())
  tenantId String

  name     String
  language String
  category WaTemplateCategory

  /// Meta's component array verbatim (HEADER/BODY/FOOTER/BUTTONS).
  components Json

  metaTemplateId  String?
  status          WaTemplateStatus @default(DRAFT)
  rejectionReason String?

  /// Meta never announces a verdict on a schedule we control, so a cron asks.
  lastSyncedAt DateTime?
  submittedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   WaTenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages WaMessage[]

  /// Meta's own uniqueness rule: one name per language per WABA.
  @@unique([tenantId, name, language])
  @@index([tenantId, status])
  @@index([metaTemplateId])
}

/// One sent or received message. Also the billing meter — every outbound row has
/// a wallet debit written in the same transaction.
model WaMessage {
  id       String @id @default(cuid())
  tenantId String

  direction WaMessageDirection
  status    WaMessageStatus    @default(QUEUED)

  /// E.164 digits, no plus. The tenant's counterparty either way.
  contactPhone String
  phoneNumberId String?

  templateId String?
  /// Copied from the template at send time: a template can be recategorised by
  /// Meta later, and this row must still say what it was billed as.
  category WaTemplateCategory?

  metaMessageId String?
  payload       Json
  error         String?

  tenantPricePaise   Int?
  platformPricePaise Int?

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   WaTenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template WaTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([metaMessageId])
  @@index([tenantId, contactPhone, createdAt])
}

/// Raw inbound webhook events, kept for dedupe. Meta retries delivery, and
/// without this an autoreply fires twice for one inbound message.
model WaWebhookEvent {
  id String @id @default(cuid())

  /// Meta's own id for the event. The unique index IS the dedupe.
  metaEventId String @unique

  phoneNumberId String?
  tenantId      String?
  field         String
  payload       Json

  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([phoneNumberId])
}

/// Prepaid balance. Recharge first, then send — nothing is invoiced in arrears.
///
/// `ownerId` is polymorphic (a WaPlatform id or a WaTenant id) so it carries no
/// foreign key on purpose. `ownerType` disambiguates.
///
/// `balancePaise` is a cached rollup of WaWalletTxn, which is the truth.
/// Integer paise, never a float, never rupees.
model WaWallet {
  id        String            @id @default(cuid())
  ownerType WaWalletOwnerType
  ownerId   String

  balancePaise Int @default(0)
  /// Reserved by in-flight broadcasts. Spendable = balancePaise - heldPaise.
  heldPaise    Int @default(0)

  lowBalanceThresholdPaise Int       @default(0)
  lowBalanceNotifiedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  txns WaWalletTxn[]

  @@unique([ownerType, ownerId])
}

/// Append-only ledger. Never update a row here; write a compensating one.
model WaWalletTxn {
  id       String          @id @default(cuid())
  walletId String
  /// Signed: negative debits, positive credits.
  amountPaise       Int
  kind              WaWalletTxnKind
  balanceAfterPaise Int

  /// Not foreign keys — WaMessage and WaBroadcast arrive in later phases.
  messageId   String?
  broadcastId String?

  /// Idempotency key, scoped to the wallet. A retried send reuses it and the
  /// unique index makes the second debit a no-op instead of charging twice.
  ///
  /// Scoped, NOT global: platforms choose their own keys, so two of them will
  /// eventually both send "topup-1". A global unique index would make the second
  /// platform's call match the first's row and read back a balance that is not
  /// theirs.
  refKey String?
  note   String?

  createdAt DateTime @default(now())

  wallet WaWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, refKey])
  @@index([walletId, createdAt])
}

/// What a message costs us, what we charge the platform, and what the platform
/// charges its tenant — per category, because a flat rate loses money on
/// marketing. `tenantPricePaise` is the platform's own decision.
model WaPriceRule {
  id         String             @id @default(cuid())
  platformId String
  category   WaTemplateCategory

  metaCostPaise      Int
  platformPricePaise Int
  tenantPricePaise   Int

  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())

  platform WaPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([platformId, category, effectiveFrom])
  @@index([platformId, category])
}
