{
  "name": "@glitchgrab/whatsapp",
  "version": "0.1.0",
  "description": "WhatsApp Business messaging for SaaS products \u2014 connect a customer's own number, send templates, and run a shared inbox.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6",
    "@semantic-release/commit-analyzer": "^13",
    "@semantic-release/git": "^10",
    "@semantic-release/github": "^11",
    "@semantic-release/npm": "^12",
    "@semantic-release/release-notes-generator": "^14",
    "@types/react": "^19",
    "conventional-changelog-conventionalcommits": "^8",
    "react": "^19",
    "semantic-release": "^24",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^4.1.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Navibyte-Innovations-Pvt-Ltd/glitchgrab.git",
    "directory": "packages/sdk-whatsapp"
  },
  "license": "MIT",
  "keywords": [
    "whatsapp",
    "whatsapp-business",
    "messaging",
    "saas",
    "multi-tenant"
  ]
}
